{
  "name": "@z-cloud/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --external:postgres --external:drizzle-orm --external:drizzle-orm/* --external:hono --external:hono/* --external:@hono/node-server --external:zod --external:proper-lockfile --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test src/app.test.ts src/transfers.test.ts"
  },
  "dependencies": {
    "postgres": "^3.4.7",
    "drizzle-orm": "^0.44.0",
    "zod": "^4.1.0",
    "hono": "^4.13.18",
    "@hono/node-server": "^1.19.0",
    "@z-cloud/contracts": "workspace:*",
    "@z-cloud/db": "workspace:*",
    "@z-cloud/core": "workspace:*",
    "proper-lockfile": "^4.1.2",
    "@aws-sdk/client-s3": "^3.0.0",
    "@z-cloud/storage": "workspace:*"
  },
  "exports": {
    ".": "./src/app.ts"
  }
}
