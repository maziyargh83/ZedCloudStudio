{
  "name": "@z-cloud/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "build": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/stdio.js --external:@modelcontextprotocol/sdk/* --external:zod --external:proper-lockfile --external:postgres --external:drizzle-orm --external:drizzle-orm/* --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server.test.ts src/stdio.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@z-cloud/adventure-journal": "workspace:*",
    "@z-cloud/ai-memory": "workspace:*",
    "@z-cloud/contracts": "workspace:*",
    "@z-cloud/core": "workspace:*",
    "@z-cloud/db": "workspace:*",
    "@z-cloud/media-library": "workspace:*",
    "@z-cloud/storage": "workspace:*",
    "@z-cloud/youtube-publisher": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.7",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.1.0"
  }
}
